MONGO_URI=mongodb://localhost:27017
MONGO_DB=intucate

# which model backend answers the prompts:
#   mock    - canned local response, no network, no key (default)
#   nim     - your local proxy to NVIDIA NIM at :9797, no key needed
#   groq    - Groq cloud, needs GROQ_API_KEY
#   gemini  - Gemini via its OpenAI-compatible endpoint, needs GEMINI_API_KEY
#   openai  - OpenAI, needs OPENAI_API_KEY
LLM_PROVIDER=mock

# override the provider's default model if you want a specific one
# LLM_MODEL=meta/llama-3.2-90b-vision-instruct

GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
